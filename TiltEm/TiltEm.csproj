<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>TiltEm</AssemblyName>
    <RootNamespace>TiltEm</RootNamespace>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KSPBuildTools" Version="1.1.1" />
  </ItemGroup>

  <!-- Mod assemblies resolved from $(KSPBT_GameRoot); set that in TiltEm.props.user -->
  <ItemGroup>
    <ModReference Include="0Harmony">
      <DLLPath>GameData/000_Harmony/0Harmony.dll</DLLPath>
    </ModReference>
    <ModReference Include="Kopernicus">
      <DLLPath>GameData/Kopernicus/Plugins/Kopernicus.dll</DLLPath>
    </ModReference>
    <ModReference Include="Kopernicus.Parser">
      <DLLPath>GameData/Kopernicus/Plugins/Kopernicus.Parser.dll</DLLPath>
    </ModReference>
    <ModReference Include="ModularFlightIntegrator">
      <DLLPath>GameData/ModularFlightIntegrator/ModularFlightIntegrator.dll</DLLPath>
    </ModReference>
  </ItemGroup>

  <!-- Ship the non-code half of the mod alongside the DLLs so GameData/TiltEm is installable as-is -->
  <ItemGroup>
    <TiltEmResource Include="$(MSBuildThisFileDirectory)../Resources/**/*" />
  </ItemGroup>

  <Target Name="TiltEmCopyResources" AfterTargets="KSPBT_CopyDLLsToPluginFolder"
          Inputs="@(TiltEmResource)" Outputs="@(TiltEmResource->'$(KSPBT_ModRoot)/%(RecursiveDir)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(TiltEmResource)" DestinationFolder="$(KSPBT_ModRoot)/%(RecursiveDir)" />
  </Target>

</Project>
